# port the API listens on
PORT=3000
# connection to the PostgreSQL database from docker-compose.yml
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/konsultacje
# secret used to sign the JWT tokens (in the cookie)
JWT_SECRET=zmien-mnie-na-dlugi-losowy-ciag-znakow
# demo login without a password (pick a user from a list)
AUTH_MOCK_ENABLED=true
# "Reset demo data" button in the admin panel
DEMO_RESET_ENABLED=true
# SMTP server — Mailpit from docker-compose.yml
SMTP_HOST=localhost
SMTP_PORT=1025
# sender of the e-mails
MAIL_FROM="Konsultacje <no-reply@konsultacje.local>"
# frontend address used in links inside e-mails
APP_URL=http://localhost:5173
# booking closes 15 min before the slot starts
BOOKING_CUTOFF_MINUTES=15
# a student can cancel a booking until 60 min before the start
CANCEL_CUTOFF_MINUTES=60
# maximum number of active bookings of one student
MAX_ACTIVE_BOOKINGS_PER_STUDENT=3
# worker that sends e-mails every 10 s
OUTBOX_ENABLED=true
# pino log level
LOG_LEVEL=info
