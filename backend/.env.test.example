# Port, na którym działa API
PORT=3000
# Testy używają osobnej bazy konsultacje_test (tworzy ją skrypt docker/postgres/init)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/konsultacje_test
# Sekret do podpisywania tokenów JWT (w cookie)
JWT_SECRET=sekret-tylko-do-testow-nie-uzywac-gdzie-indziej
# Logowanie demo bez hasła (wybór użytkownika z listy)
AUTH_MOCK_ENABLED=true
# Przycisk „Resetuj dane demo” w panelu admina
DEMO_RESET_ENABLED=true
# Serwer SMTP — Mailpit z docker-compose.yml
SMTP_HOST=localhost
SMTP_PORT=1025
# Nadawca e-maili
MAIL_FROM="Konsultacje <no-reply@konsultacje.local>"
# Adres frontendu w linkach w e-mailach
APP_URL=http://localhost:5173
# Zapisy zamykają się 15 min przed startem slotu
BOOKING_CUTOFF_MINUTES=15
# Student może odwołać rezerwację do 60 min przed startem
CANCEL_CUTOFF_MINUTES=60
# Maksymalna liczba aktywnych rezerwacji jednego studenta
MAX_ACTIVE_BOOKINGS_PER_STUDENT=3
# W testach worker e-maili jest wyłączony
OUTBOX_ENABLED=false
# W testach bez logów
LOG_LEVEL=silent
